{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && data.child('meta/host').val() === auth.uid && !newData.exists()",
        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid)",
          ".validate": "newData.hasChildren(['host', 'seed', 'len', 'lvl', 'secs', 'state']) && newData.child('host').val() === auth.uid"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($room).child('meta').exists()",
            "name":   { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16" },
            "score":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
            "streak": { ".validate": "newData.isNumber()" },
            "online": { ".validate": "newData.isBoolean()" },
            "round":  { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "answers": {
          "$key": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms').child($room).child('meta').exists()"
            }
          }
        }
      }
    }
  }
}
